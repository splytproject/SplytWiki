---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for d in site.wiki -%}
  {%- capture clean -%}{% include strip-refs.html html=d.content %}{%- endcapture -%}
  {%- assign body = clean | strip_html | normalize_whitespace | strip -%}
  {%- assign lead = clean | split: '<h2' | first | strip_html | normalize_whitespace | strip | truncate: 340 -%}
  {
    "t": {{ d.title | jsonify }},
    "u": {{ d.url | jsonify }},
    "d": {{ d.description | default: "" | jsonify }},
    "a": {{ d.aliases | jsonify }},
    "i": {{ d.infobox.image | default: "" | jsonify }},
    "m": {{ d.updated | default: site.time | date: "%-d %B %Y" | jsonify }},
    "x": {{ lead | jsonify }},
    "b": {{ body | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
